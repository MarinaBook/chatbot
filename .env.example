# generate a random secret: https://generate-secret.vercel.app/32 or `openssl rand -base64 32`
AUTH_SECRET=****

# required for non-vercel deployments, vercel uses OIDC automatically
# https://vercel.com/ai-gateway
AI_GATEWAY_API_KEY=****

# shared with the MarinaBook frontend server for POST /api/chat Bearer auth
CHATBOT_API_SECRET=****

# https://vercel.com/docs/vercel-blob
BLOB_READ_WRITE_TOKEN=****

# https://vercel.com/docs/postgres
POSTGRES_URL=****

# https://vercel.com/docs/redis
REDIS_URL=****

# MarinaBook backend base URL, for example https://api.marinabook.app
MARINABOOK_API_URL=****

# MarinaBook assistant API key used only by the chatbot server
MARINABOOK_ASSISTANT_API_KEY=****
